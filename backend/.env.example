# Plantilla de variables de entorno del backend.
# Copiar como .env y ajustar. El archivo .env NO se versiona.

# --- Base de datos ---
# Demo (por defecto): SQLite asíncrono, se crea solo con `alembic upgrade head`.
DATABASE_URL=sqlite+aiosqlite:///./bingo.db
# Fase 2 / producción en LAN — PostgreSQL (requiere instalar asyncpg):
# DATABASE_URL=postgresql+asyncpg://bingo:clave@localhost:5432/bingo

# Muestra el SQL generado por SQLAlchemy en consola. Útil al depurar.
DB_ECHO=false

# --- CORS ---
# Orígenes autorizados, separados por coma, en formato lista JSON.
# En la instalación en LAN se pone la IP del servidor de la sala.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
